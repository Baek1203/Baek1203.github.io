<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>조건 전달 · 교사 전용</title>
<style>
  :root{
    --bg:#1B1A22; --card:#25242E; --line:#3A3846; --ink:#EDEAF2; --soft:#9A94A8;
    --mint:#4FC3A6; --peach:#FF8E6E; --lav:#9E90E8; --sun:#F2B843; --red:#E0574B;
    --f:"Pretendard","Pretendard Variable",-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic","Noto Sans KR",sans-serif;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;margin:0}
  body{font-family:var(--f);background:var(--bg);color:var(--ink);word-break:keep-all}
  .app{height:100dvh;display:flex;flex-direction:column}
  .top{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:11px 15px;flex:0 0 auto;
    background:var(--card);border-bottom:1px solid var(--line)}
  .logo{font:900 14px/1 var(--f)}
  .logo b{color:var(--red)}
  .warn{font:800 11px/1 var(--f);color:#FFC7BE;background:#5A2A24;border-radius:99px;
    padding:7px 11px;border:1px solid #7A3A32}
  select{font:800 13px/1 var(--f);padding:9px 11px;border-radius:10px;border:1px solid var(--line);
    background:#1F1E27;color:var(--ink)}
  .sp{flex:1}
  .chip{font:800 11px/1 var(--f);padding:7px 11px;border-radius:99px;background:#2C2B36;
    border:1px solid var(--line);color:var(--soft)}
  .chip.on{background:#1E3B33;border-color:#2F6455;color:#7FE0C4}
  .chip.off{background:#4A2622;border-color:#7A3A32;color:#FFB3A6}
  .body{flex:1;min-height:0;overflow:auto;padding:16px 18px 40px}
  .mid{max-width:900px;margin:0 auto;display:grid;grid-template-columns:1.15fr .85fr;gap:20px}
  @media (max-width:820px){.mid{grid-template-columns:1fr}}

  .fig{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:12px}
  .fig svg{width:100%;height:min(52vh,420px);display:block}
  .hit{cursor:pointer}
  .panel{display:grid;gap:12px;align-content:start}
  .box{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:15px 17px}
  .box h3{margin:0 0 10px;font:900 12.5px/1 var(--f);color:var(--soft);letter-spacing:.06em}
  .picks{display:grid;gap:8px}
  .pk{display:flex;align-items:center;gap:10px;background:#1F1E27;border:1px solid var(--line);
    border-radius:12px;padding:12px 14px;font:800 15px/1 var(--f)}
  .pk.on{border-color:var(--sun);background:#3A3020;color:var(--sun)}
  .pk .x{margin-left:auto;cursor:pointer;color:var(--soft);font-weight:900}
  .empty{font:700 12.5px/1.6 var(--f);color:var(--soft)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .b{font:800 12.5px/1 var(--f);padding:12px 10px;border-radius:11px;cursor:pointer;
    border:1px solid var(--line);background:#2C2B36;color:var(--ink);text-align:center}
  .b:hover{border-color:var(--soft)}
  .b.go{background:var(--sun);border-color:var(--sun);color:#2A2008;font-weight:900}
  .b.go:disabled{background:#3A3846;border-color:#3A3846;color:#6C667A;cursor:default}
  .b.rev{background:var(--red);border-color:var(--red);color:#fff;font-weight:900}
  .b.wide{grid-column:1/-1}
  .stat{font:800 13px/1.7 var(--f);color:var(--soft)}
  .stat b{color:var(--ink)}
  .sent{background:#1E3B33;border:1px solid #2F6455;border-radius:12px;padding:12px 14px;
    font:800 13px/1.6 var(--f);color:#7FE0C4}
  .tip{font:700 11.5px/1.7 var(--f);color:var(--soft)}
  :focus-visible{outline:2px solid var(--sun);outline-offset:2px}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <span class="logo">조건 전달 · <b>교사 전용</b></span>
    <span class="warn">전자칠판에 띄우지 마세요</span>
    <select id="cls"><option>1-1</option><option>1-2</option><option>1-3</option><option>1-4</option></select>
    <span class="sp"></span>
    <span class="chip" id="net">연결 확인 중</span>
  </div>
  <div class="body"><div class="mid">
    <div class="fig" id="fig"></div>
    <div class="panel" id="panel"></div>
  </div></div>
</div>

<script>
"use strict";
const $=i=>document.getElementById(i);
const DB="https://jak-do-default-rtdb.asia-southeast1.firebasedatabase.app";
const gj=async p=>{const r=await fetch(`${DB}/${p}.json`);if(!r.ok)throw 0;return r.json();};
const pj=async(p,v)=>{const r=await fetch(`${DB}/${p}.json`,{method:"PUT",
  headers:{"Content-Type":"application/json"},body:JSON.stringify(v)});if(!r.ok)throw 0;};
const dj=async p=>{const r=await fetch(`${DB}/${p}.json`,{method:"DELETE"});if(!r.ok)throw 0;};
let ON=null;
const setNet=ok=>{if(ON===ok)return;ON=ok;
  $("net").className="chip "+(ok?"on":"off");$("net").textContent=ok?"연결됨":"연결 안 됨";};
const R2D=180/Math.PI, D2R=Math.PI/180;

/* ── 삼각형 꾸러미: 두 변과 끼인각으로 정한다 ── */
const POOL=[
  {c:7,b:5,A:50},  {c:6,b:6,A:70},  {c:8,b:4,A:40},
  {c:6,b:5,A:95},  {c:7,b:7,A:34},  {c:9,b:5,A:58}
];
function build(p){
  const A=p.A*D2R;
  const a=Math.sqrt(p.b*p.b+p.c*p.c-2*p.b*p.c*Math.cos(A));   /* BC */
  const B=Math.asin(Math.min(1,p.b*Math.sin(A)/a))*R2D;
  const C=180-p.A-B;
  return {sides:{BC:a,CA:p.b,AB:p.c},angles:{A:p.A,B:B,C:C}};
}
let PI=+(localStorage.getItem("send.pi")||0), TRI=build(POOL[PI]);
let SEL=[], SENT=null, SUBS={}, ANS=null;
let V={cls:localStorage.getItem("send.cls")||"1-1"};

/* ── 그림 ── */
function coords(T){
  const A={x:80,y:250};
  const B={x:A.x+T.sides.AB*34,y:A.y};
  const th=-T.angles.A*D2R;
  const C={x:A.x+T.sides.CA*34*Math.cos(th),y:A.y+T.sides.CA*34*Math.sin(th)};
  return {A,B,C};
}
const f1=x=>(Math.round(x*10)/10).toString().replace(/\.0$/,"");
function fig(){
  const P=coords(TRI),V3=[["A",P.A],["B",P.B],["C",P.C]];
  const cx=(P.A.x+P.B.x+P.C.x)/3, cy=(P.A.y+P.B.y+P.C.y)/3;
  const sel=k=>SEL.some(s=>s.k===k);
  let g=`<svg viewBox="0 0 460 300" xmlns="http://www.w3.org/2000/svg">
    <polygon points="${P.A.x},${P.A.y} ${P.B.x},${P.B.y} ${P.C.x},${P.C.y}"
      fill="#2C2B36" stroke="#7C7690" stroke-width="3"/>`;
  /* 변 */
  [["AB",P.A,P.B],["BC",P.B,P.C],["CA",P.C,P.A]].forEach(([nm,a,b])=>{
    const on=sel("s"+nm);
    g+=`<line class="hit" data-k="s${nm}" x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}"
      stroke="${on?"#F2B843":"#EDEAF2"}" stroke-width="${on?9:5}" stroke-linecap="round"/>`;
    const mx=(a.x+b.x)/2,my=(a.y+b.y)/2;
    let dx=mx-cx,dy=my-cy,L=Math.hypot(dx,dy)||1;dx/=L;dy/=L;
    g+=`<text class="hit" data-k="s${nm}" x="${(mx+dx*26).toFixed(1)}"
      y="${(my+dy*26+6).toFixed(1)}" text-anchor="middle" font-size="18" font-weight="800"
      fill="${on?"#F2B843":"#C6C0D4"}" font-family="sans-serif">${f1(TRI.sides[nm])}</text>`;
  });
  /* 각 */
  V3.forEach(([n,v],i)=>{
    const u=V3[(i+2)%3][1],w=V3[(i+1)%3][1];
    const a1=Math.atan2(u.y-v.y,u.x-v.x),a2=Math.atan2(w.y-v.y,w.x-v.x);
    let dd=a2-a1;while(dd>Math.PI)dd-=2*Math.PI;while(dd<-Math.PI)dd+=2*Math.PI;
    const r=34,on=sel("a"+n);
    const Q=t=>`${(v.x+r*Math.cos(t)).toFixed(1)},${(v.y+r*Math.sin(t)).toFixed(1)}`;
    g+=`<path class="hit" data-k="a${n}" d="M${Q(a1)} A ${r} ${r} 0 0 ${dd>0?1:0} ${Q(a2)}"
      fill="none" stroke="${on?"#F2B843":"#9A94A8"}" stroke-width="${on?7:3}"/>`;
    const tm=a1+dd/2,rr=r+22;
    g+=`<text class="hit" data-k="a${n}" x="${(v.x+rr*Math.cos(tm)).toFixed(1)}"
      y="${(v.y+rr*Math.sin(tm)+5).toFixed(1)}" text-anchor="middle" font-size="16"
      font-weight="800" fill="${on?"#F2B843":"#9A94A8"}"
      font-family="sans-serif">${f1(TRI.angles[n])}°</text>`;
  });
  V3.forEach(([n,v])=>{
    let dx=v.x-cx,dy=v.y-cy,L=Math.hypot(dx,dy)||1;dx/=L;dy/=L;
    g+=`<circle cx="${v.x}" cy="${v.y}" r="5.5" fill="#EDEAF2"/>
      <text x="${(v.x+dx*24).toFixed(1)}" y="${(v.y+dy*24+8).toFixed(1)}" text-anchor="middle"
        font-size="21" font-weight="800" fill="#EDEAF2" font-family="serif">${n}</text>`;
  });
  $("fig").innerHTML=g+"</svg>";
  $("fig").querySelectorAll(".hit").forEach(el=>el.onclick=()=>toggle(el.dataset.k));
}
function toggle(k){
  const i=SEL.findIndex(s=>s.k===k);
  if(i>=0){SEL.splice(i,1);return paint();}
  if(SEL.length>=2)SEL.shift();
  SEL.push(k[0]==="s"
    ?{k,t:"seg",n:k.slice(1),v:TRI.sides[k.slice(1)]}
    :{k,t:"ang",n:k.slice(1),v:TRI.angles[k.slice(1)]});
  paint();
}
const label=s=>s.t==="seg"?`변 ${s.n} = ${f1(s.v)}`:`∠${s.n} = ${f1(s.v)}°`;

async function send(){
  const items=SEL.map(s=>s.t==="seg"?{t:"seg",cm:+f1(s.v)}:{t:"ang",deg:+f1(s.v)});
  const task={items,at:Date.now(),tag:SEL.map(s=>s.k).join("")};
  try{
    await dj(`t2x/${V.cls}/subs`).catch(()=>{});
    await dj(`t2x/${V.cls}/mark`).catch(()=>{});
    await dj(`t2x/${V.cls}/answer`).catch(()=>{});
    await pj(`t2x/${V.cls}/task`,task);setNet(true);SENT=task;ANS=null;
  }catch(e){setNet(false);}
  paint();
}
async function reveal(){
  const P=coords(TRI);
  const v=[[P.A.x,P.A.y],[P.B.x,P.B.y],[P.C.x,P.C.y]];
  try{await pj(`t2x/${V.cls}/answer`,{v,
    sides:{BC:+f1(TRI.sides.BC),CA:+f1(TRI.sides.CA),AB:+f1(TRI.sides.AB)},
    angles:{A:+f1(TRI.angles.A),B:+f1(TRI.angles.B),C:+f1(TRI.angles.C)},
    at:Date.now()});setNet(true);ANS=true;}catch(e){setNet(false);}
  paint();
}
async function pull(){
  try{
    const [t,s,a]=await Promise.all([gj(`t2x/${V.cls}/task`),
      gj(`t2x/${V.cls}/subs`),gj(`t2x/${V.cls}/answer`)]);
    SENT=t||null;SUBS=s||{};ANS=a?true:null;setNet(true);
  }catch(e){setNet(false);}
  paint();
}
function paint(){
  fig();
  const n=Object.keys(SUBS).length;
  $("panel").innerHTML=`
    <div class="box"><h3>고른 조건 ${SEL.length} / 2</h3>
      <div class="picks">${SEL.length?SEL.map(s=>
        `<div class="pk on">${label(s)}<span class="x" data-x="${s.k}">✕</span></div>`).join("")
        :`<p class="empty">왼쪽 그림에서 <b>변</b>이나 <b>각</b>을 두 개 누르세요.<br>
          숫자나 선을 눌러도 됩니다.</p>`}</div>
      <div class="grid2" style="margin-top:12px">
        <button class="b go wide" id="send"${SEL.length===2?"":" disabled"}>학생에게 전송</button>
      </div>
      <p class="tip" style="margin:10px 0 0">전송하면 이전 제출과 정답 공개가 지워집니다.</p>
    </div>
    <div class="box"><h3>진행</h3>
      ${SENT?`<div class="sent">보낸 조건 · ${SENT.items.map(i=>
        i.t==="seg"?`선분 ${i.cm}`:`각 ${i.deg}°`).join(" / ")}</div>`
        :`<p class="empty">아직 보내지 않았습니다.</p>`}
      <p class="stat" style="margin:12px 0 0">제출한 학생 <b>${n}명</b></p>
      <div class="grid2" style="margin-top:10px">
        <button class="b rev wide" id="rev"${SENT?"":" disabled"}>${
          ANS?"정답 다시 공개":"정답 삼각형 공개"}</button>
      </div>
      <p class="tip" style="margin:10px 0 0">공개하면 전자칠판 화면에 원래 삼각형이 뜹니다.
        그전에는 어디에도 저장되지 않습니다.</p>
    </div>
    <div class="box"><h3>삼각형 바꾸기</h3>
      <div class="grid2">${POOL.map((p,i)=>
        `<button class="b${i===PI?" go":""}" data-p="${i}">${i+1}. ${p.c}·${p.b}·${p.A}°</button>`
        ).join("")}</div>
      <p class="tip" style="margin:10px 0 0">두 변과 끼인각으로 정해진 삼각형입니다.
        바꾸면 고른 조건이 지워집니다.</p>
    </div>`;
  $("send").onclick=send;
  $("rev").onclick=reveal;
  $("panel").querySelectorAll("[data-x]").forEach(b=>b.onclick=()=>toggle(b.dataset.x));
  $("panel").querySelectorAll("[data-p]").forEach(b=>b.onclick=()=>{
    PI=+b.dataset.p;localStorage.setItem("send.pi",PI);TRI=build(POOL[PI]);SEL=[];paint();});
}
$("cls").value=V.cls;
$("cls").onchange=e=>{V.cls=e.target.value;localStorage.setItem("send.cls",V.cls);
  e.target.blur();SEL=[];pull();};
setInterval(pull,2500);
pull();
</script>
</body>
</html>
